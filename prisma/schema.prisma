// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../main/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Match {
  id String @id()

  gameLengthInMs BigInt
  gameVersion    String
  mapId          String
  platform       String
  modeId         String
  seasonId       String
  cluster        String?
  startedAt      DateTime
  region         String
  winningTeamId  String

  players MatchPlayer[]
  rounds  MatchRound[]
  kills   Kill[]
}

model MatchRound {
  combinedId String @id()

  id            Int
  result        String
  ceremony      String
  winningTeamId String

  defusePlayerUuid    String?
  defusePlayerTeamId  String?
  defuseRoundTimeInMs BigInt?
  defused             Boolean
  defuseX             Int?
  defuseY             Int?

  plantPlayerUuid    String?
  plantPlayerTeamId  String?
  plantSite          String?
  planted            Boolean
  plantRoundTimeInMs BigInt?
  plantX             Int?
  planY              Int?

  playerStats MatchRoundPlayerStats[]
  match       Match                   @relation(fields: [matchId], references: [id])
  matchId     String
}

model MatchRoundPlayerStats {
  combinedId String @id()

  puuid  String
  teamId String

  ability1CastCount  Int
  ability2CastCount  Int
  signatureCastCount Int
  ultimateCastCount  Int
  score              Int
  killsCount         Int
  headShotsCount     Int
  bodyShotsCount     Int
  legShotsCount      Int
  loadoutValue       Int
  remainingCredits   Int
  weaponId           String
  armorId            String?
  wasAfk             Boolean
  receivedPenalty    Boolean
  stayedInSpawn      Boolean

  damageEvents MatchRoundPlayerStatsDamageEvents[]

  matchRound           MatchRound @relation(fields: [matchRoundCombinedId], references: [combinedId])
  matchRoundCombinedId String
}

model MatchRoundPlayerStatsDamageEvents {
  combinedId String @id()

  playerUuid    String
  playerTeamId  String
  bodyShotCount Int
  headShotCount Int
  legShotCount  Int
  damage        Int

  matchRoundPlayerStats           MatchRoundPlayerStats? @relation(fields: [matchRoundPlayerStatsCombinedId], references: [combinedId])
  matchRoundPlayerStatsCombinedId String?
}

model MatchPlayer {
  combinedId String @id()

  puuid                String
  name                 String
  tag                  String
  ability1CastCount    Int
  ability2CastCount    Int
  signatureCastCount   Int
  ultimateCastCount    Int
  level                Int
  agentId              String
  afkRoundsCount       Float
  friendlyFireIncoming Float
  friendlyFireOutgoing Float
  roundsInSpawnCount   Float
  cardId               String
  titleId              String
  loadoutAverage       Float
  loadoutOverall       Int
  averageSpent         Float
  overallSpent         Int
  partyId              String
  sessionPlaytimeInMs  BigInt
  assistsCount         Int
  killsCount           Int
  deathsCounts         Int
  bodyShotsCount       Int
  headShotsCount       Int
  legShotsCount        Int
  damageDealt          Int
  damageReceived       Int
  score                Int
  tierId               String

  match   Match  @relation(fields: [matchId], references: [id])
  matchId String
}

model Kill {
  combinedId String @id()
  matchId    String

  round             Int
  killerPuuid       String
  killerTeamId      String
  x                 Int
  y                 Int
  secondaryFireMode Boolean
  timeInMatchInMs   BigInt
  timeInRoundInMs   BigInt
  victimPuuid       String
  victimTeamId      String
  weaponId          String

  assistants KillAssistant[]
  match      Match           @relation(fields: [matchId], references: [id])
}

model KillAssistant {
  combinedId String @id

  puuid  String
  teamId String

  kill           Kill   @relation(fields: [killCombinedId], references: [combinedId])
  killCombinedId String
}
